# Deepskopion .gitignore
# Project-specific ignore patterns for FPGA development

# ── Python ──────────────────────────────────────────────
*.py[cod]
__pycache__/
.venv/

# ── IDE / OS ────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ── Compiled / Build Artifacts ──────────────────────────
*.o
*.cf
*.ghw
*.vcd
*.fst
# The one shipped capture a newcomer opens without building anything.
!docs/captures/*.fst
*.dcp
*.class
*.jar
*.app
*.exe
*.war
*.log

# ── Large Media ─────────────────────────────────────────
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ── Simulation ──────────────────────────────────────────
sim/work/
sim/results/
sim/lint.log
sim/lint.status
sim_build/
hw/sim/work/
# nvc's work-library lock, rewritten (a pid) by every sim run.
hw/sim/work.lock
**/test_output.txt
**/test_results.txt

# ── Build Caches & Tool Temp ───────────────────────────
.routertl_cache/
.routertl_commit
.Xil/
dcp/
ip_cache/
.deps.ok
work/
logs/
node_modules/
dist/
target/

# ── Vendored External Dependencies (fetched at build) ──
# libs/xpm_vhdl was removed — XPM now comes from the shared
# routertl vendor_libs cache; no clone is ever fetched into this repo.
libs/ctu-fee/
# rr's per-target vendored roots (packages_lock: target, libs/.targets/<t>/).
# The bench CTU targets vendor the CTU core here; it is fetched, never committed.
libs/.targets/
libs/enclustra/
libs/open-logic/
# Registry IP is fetched by rr workspace sync / rr pkg add, never vendored.
libs/routertl/rea/
libs/routertl/rr_ddr_stream/

# ── Stale Outputs (should never be committed) ──────────
full_output.txt
out.txt

# ── Unit test reports ───────────────────────────────────
TEST*.xml
*.fst.session

# PM tools live in external tools/ — never copy them here
tools/t[l]og.py
tools/tcap.py
tools/tctx.py
tools/tdecision.py
tools/thint.py
tools/thazard.py
tools/_pm_lock.py



# --- RouteRTL pre-build outputs ---
# (kept tracked; the resolver respects .gitignore patterns even for
#  tracked files, which hides these from auto-discovery and breaks
#  library `tich` membership for downstream packages.)
# hw/rtl/pkg/datalogger_config_pkg.vhd
# hw/rtl/datalogger/infra/datalogger_gather.vhd
# --- end RouteRTL pre-build outputs ---

# ── UI Runtime & Development Config ────────────────────
.[c]laude/
# Agent config, same policy as routertl's own equivalent: local scratch
# only, never part of the public clone-and-build front door.
/[G]EMINI.md
# debug/ holds local debug scratch AND the tracked RouteRTL debug-core
# declarations (debug/<name>.yml) that `rr ila` / `rr hw bit-sha` resolve the
# on-chip REA node from. Keep the scratch ignored but TRACK the
# core yml files — the same convention rr-vfifo / examples/de25_rea_demo use.
/debug/*
!/debug/*.yml
/debug_cocotbext.py
imgui.ini
routewave_window.ini
mock.session
# Physical cable identities, UART paths, addresses, and host service roots are
# deployment state, never public source. Copy hw.example.yml to
# runtimes/hw.local.yml. runtimes/hw.yml itself is TRACKED — it is
# the rr.hw.contract/v1 hardware contract, carries no bench block, and points
# rr's bench resolver at hw.local.yml via `extends:`.
/runtimes/hw.local.yml
sw/linux/buildroot/
sw/linux/python_overlay/
sw/linux/de25/.cache/
sw/linux/de25/rootfs_overlay/
sw/linux/de25/python_overlay/
sw/linux/de25/out/
sw/linux/de25/src/
# PF-L0: the riscv64 PolarFire overlay + its Buildroot tree are
# generated by sw/linux/pfsoc/build_python_overlay.sh — never tracked.
sw/linux/pfsoc/buildroot/
sw/linux/pfsoc/python_overlay/
# Generated by stage_daemon.sh. Never track: tarfile data_filter
# refuses a committed `../` symlink in the clean-clone gate.
sw/linux/pfsoc/rootfs_overlay
# PF-L0 boot session 2026-09-06: the pfsoc mirrors of the de25 rules above.
# `rr linux hss|uboot|kernel` clones hart-software-services / u-boot / linux into
# sw/linux/pfsoc/src/ and writes artifacts to sw/linux/pfsoc/out/ — multi-GB build
# output that must never be tracked. The de25 target already ignores both; the
# pfsoc pair was missing, so a first PolarFire build leaves them staged-able.
sw/linux/pfsoc/out/
sw/linux/pfsoc/src/
# Staged standalone aarch64-none-linux-gnu toolchain — regenerated
# from a checksum-pinned download by tools/de25_toolchain_stage.py; ~700 MiB
# unpacked, never tracked.
sw/linux/de25/toolchain/
# Everything under sw/linux/src is cloned/generated at build time by `rr linux`
# (kernel, u-boot, busybox, device-tree generator + the DT/FSBL workspaces).
# Nothing here is tracked — it's all regenerated on fetch/build.
sw/linux/src/
# Staged dropbear armhf binary for the Zynq targets (regenerated by
# sw/linux/stage_dropbear_overlay.sh). The PolarFire kit's rv64gc dropbear/scp
# live under sw/linux/pfsoc/python_overlay/ (already ignored above), extracted by
# sw/linux/pfsoc/build_python_overlay.sh — never this shared ARM one.
sw/linux/rootfs_overlay/usr/sbin/dropbear
# Staged can-utils + iproute2 ARM binaries (regenerated by sw/linux/stage_can_overlay.sh)
sw/linux/rootfs_overlay/usr/sbin/ip
sw/linux/rootfs_overlay/usr/bin/cansend
sw/linux/rootfs_overlay/usr/bin/candump
sw/linux/rootfs_overlay/usr/bin/cangen
sw/linux/rootfs_overlay/usr/bin/candatalogger
# Staged OpenSSH scp ARM binary + libssl/libcrypto (regenerated by
# sw/linux/stage_openssh_scp_overlay.sh)
sw/linux/rootfs_overlay/usr/bin/scp
sw/linux/rootfs_overlay/usr/lib/libssl.so.3
sw/linux/rootfs_overlay/usr/lib/libcrypto.so.3
# Staged daemon source (regenerated by sw/linux/stage_daemon.sh from sw/stream/).
# This tree was TRACKED for months while stage_daemon.sh,
# refresh_daemon_overlay.sh and sw/linux/README.md all claimed it was ignored —
# a committed second copy of sw/stream/ that nothing compared against the first.
# The only on-disk truth is sw/stream/.
sw/linux/rootfs_overlay/usr/local/share/deepskopion/sw/
# Same deal for the Wave Stream v1 contract package — the daemon imports
# it from INSIDE the staged tree (wave_stream_guard.py, parents[2]/contracts/),
# so stage_daemon.sh copies it there too. The only on-disk truth is
# contracts/wave_stream_v1/.
sw/linux/rootfs_overlay/usr/local/share/deepskopion/contracts/
# The owner's SSH key for a private image build (S49dropbear reads
# it). Owner-supplied, never committed; exactly this path, nothing wider
# (sw/linux/deployment_contract.yml owner_supplied).
sw/linux/rootfs_overlay/etc/deepskopion/authorized_keys
# rr linux rootfs's _apply_overlay_tree walks EVERY file under the
# overlay, so anything left here is baked into the initramfs. Stale .pyc beside
# freshly-staged .py is a "the fix is on the board but the old code runs" bug.
sw/linux/rootfs_overlay/**/__pycache__/
sw/linux/rootfs_overlay/**/*.pyc
sw/linux/rootfs_overlay/**/.pytest_cache/

# Generated autodiscovery source list (regenerated each build; tracking it goes stale)
build_env.tcl
build_env.mk

# ── Intel/Altera Quartus Pro generated build artifacts ──
/dni/
/qdb/
/hps_subsys.qsys
/hps_subsys/
/hps_subsys_qsys_script.*
/ip/agilex_hps/agilex_hps/intel_agilex_5_soc_1400/
/ip/f2sdram_adapter/
/ip/hps_subsys/

# ── Build outputs (Vivado project, bitstream, logs, reports — all regenerated) ──
/project/
/bitstream/
/build/
/last_build/
/reports/
/sim/
/NA/
/misc/
/.routertl/
/hw/tcl/
hw/sim/waves/
clockInfo.txt
.context.json.lock
*.healed.tcl
*.bd_heal_report.txt
/src/
sw/linux/out/
sw/linux/gen/
sw/linux/boot.scr
vivado*.jou
vivado*.log
*.backup.jou
*.backup.log
tight_setup_hold_pins.txt

# Generator-identity stamps fingerprint the locally installed RouteRTL
# implementation (wheel vs editable checkout), so they are regenerated per
# machine and must neither dirty build metadata nor be committed.
*.producer.json

# Vivado crash/debug dumps
vivado_pid*.zip
vivado_pid*.str
vivado_pid*.debug
hs_err_pid*.log

# Auto-generated register-map constants (regenerated; hw/verif keeps only .keep)
hw/verif/constants.py
# Raw self-test dumps (keep the processed records, not the raw)

# rr per-project build/job markers (regen every `rr program` / `rr build`)
.rr_pending_job
# rr per-package fetch stamp: `rr pkg install` writes one `.routertl_commit`
# (the fetched package's source SHA) into each vendored libs/ clone. Regenerated
# per fetch/machine, same policy as .rr_pending_job — never tracked, and it must
# not dirty a fresh clone (the clean-clone gate).
.routertl_commit

# Manual known-good snapshots of boot artefacts (BOOT.bin, uImage, .ko, dtb —
# local-only reference for debugging; same convention as vhdl-ethernet's
# snapshots/). Never tracked — not structured provenance, just ad-hoc backups.
sw/linux/*backups*/

# REA BUILD_ID package — regenerated from the REA source tree by the
# rr_rea_build_id pre_build hook on every build. Not committed (same policy as
# the routertl REA examples): a committed copy would go stale against the
# source it is supposed to identify.
generated/rr_rea_build_id_pkg.vhd
# Per-target generated datalogger packages (bench/targets/{canfd_demo,de25_canfd}.yml)
generated_mix/canfd_demo/
generated_mix/de25_canfd/
# Build metadata (git hash, build date, word counts), written by
# tools/regen_regbank.sh on every build (pre_build regbank-regen) and before
# every sim (pre_sim rom-info-sim). Tracking it left every clone dirty after a
# build, which split the REA design stamp across queued stages.
hw/rtl/pkg/rom_info_pkg.vhd
