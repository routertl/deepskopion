#------------------------------------------------------------------------------
# classic_eye.xdc — timing + IODELAY constraints for the LEAN Classic eye target
# (DS-P3.115). Pin LOCATIONS for led + jc are generated by
# `rr board pins-for-target` from routertl/boards/zybo/pinout.yml
# (hardware.pins in targets/classic_eye.yml) — NOT hand-listed here.
#
# UNLIKE eye_loopback.xdc, this target has a SINGLE PS7 fabric clock
# (clk_fpga_0 = 100 MHz). CLK1/RST1 are disabled in ps7_eye_classic.tcl, so
# there is NO clk_fpga_1 — the clk_fpga_0<->clk_fpga_1 set_max_delay pair and
# the deepskopion_top ddr-stream / SPI-datalogger CDC of timing.xdc do NOT apply
# and are deliberately omitted (they would reference non-existent clocks/cells).
#
# This file constrains only:
#   1. The MMCM-derived 200 MHz IDELAYCTRL refclk + the swept eye TX clock
#      (auto-derived by Vivado from the clk_fpga_0 create_clock — named here for
#      documentation; no explicit create_generated_clock needed).
#   2. The slow eye control/status CDC arcs between clk_sys and the swept eye_clk.
#   3. The eye IODELAY_GROUP — driven by the RTL `attribute IODELAY_GROUP`
#      ("eye_iodelay") on the IDELAYE2 + IDELAYCTRL; no set_property needed.
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# eye control/status CDC (clk_sys = clk_fpga_0  <->  swept eye_clk).
#
# As of the DS-P3.115 clocking rework the synchronisers live at the TOP level
# with explicit names (classic_eye_top p_start_cdc / p_status_cdc / p_probe_cdc),
# NOT inside u_eye — so the old `*u_eye/*START*` / `*u_eye/*/ERROR_COUNT*`
# filters matched no pins (Vivado 12-508, DS-T2.50). These constraints target the
# real first-stage (*_meta / *_s1) capture FFs by their D pin. eye_clk is the
# DRP-swept MMCM output, asynchronous to clk_fpga_0 across the sweep; the FFs
# carry ASYNC_REG=TRUE in RTL.
#
#   clk_sys → eye_clk : START level (engine edge-detects the synced level)
#   eye_clk → clk_sys : busy/done/lock/mmlk single bits + the REA probe bundle
#   eye_clk → clk_sys : 48-bit err/bit counters — quasi-static (read after DONE);
#                       bound the bus skew to one clk_sys period rather than
#                       false-path, so the bits can't arrive arbitrarily skewed.
#------------------------------------------------------------------------------
set_false_path -to [get_pins -hier -filter {NAME =~ *eye_start_meta_reg/D}] -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *busy_meta_reg/D}]      -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *done_meta_reg/D}]      -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *lock_meta_reg/D}]      -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *mmlk_meta_reg/D}]      -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *pb_meta_reg[*]/D}]     -quiet

set_max_delay -datapath_only 10.000 -to [get_pins -hier -filter {NAME =~ *err_cnt_s1_reg[*]/D}] -quiet
set_max_delay -datapath_only 10.000 -to [get_pins -hier -filter {NAME =~ *bit_cnt_s1_reg[*]/D}] -quiet

#------------------------------------------------------------------------------
# eye_engine internal run-window CDC (DS-P3.118): eye_clk → sample_clk.
#
# The dual-clock split (CLK_TX=eye_clk gen+FSM, CLK_RX=sample_clk checker) crosses
# the run_en + core_rst LEVELS into the sample_clk domain via 2-FF synchronisers
# inside eye_engine (run_en_meta/run_en_rx, core_rst_meta/core_rst_rx, ASYNC_REG).
# eye_clk and sample_clk are frequency-locked (same MMCM VCO) but sample_clk's
# phase is dynamically swept (CLKOUT1 fine PS), so the crossing is asynchronous —
# false-path the first-stage capture FFs' D pins. (These two arcs are the ONLY
# functional coupling between the swept clocks; the PMOD loopback is async by
# construction.)
#------------------------------------------------------------------------------
set_false_path -to [get_pins -hier -filter {NAME =~ *run_en_meta_reg/D}]   -quiet
set_false_path -to [get_pins -hier -filter {NAME =~ *core_rst_meta_reg/D}] -quiet
