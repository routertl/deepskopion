#------------------------------------------------------------------------------
# ds_cdc_evidence_impl.tcl — DS-T1.22 Libero post-route SmartTime CDC step (post_implementation)
#------------------------------------------------------------------------------
# Runs on the placed-and-routed design after VERIFYTIMING.
#
# Microchip Libero SoC SmartTime Tcl Command Reference
# (Content/smarttime/smarttime_timing_report.htm and Content/Tcl_commands/report.htm):
# In Libero SoC flow, structural CDC detection is performed during synthesis by
# Synplify Pro (set_option -report_preserve_cdc 1). For post-route timing analysis
# across clock domains, SmartTime provides inter-clock domain path reporting via:
#   report -type timing -analysis max -include_clock_domains yes -format csv <filename>
#
# Executed in SmartTime via:
#   run_tool -name {VERIFYTIMING} -script <script_file>
#
# This hook:
#   1. Prepares a SmartTime batch script to generate the post-route CDC/inter-clock report.
#   2. Executes run_tool -name {VERIFYTIMING} -script <script_file>.
#   3. Verifies that the report artifact was generated and is non-empty.
#      Absence of a report is never a pass.
#------------------------------------------------------------------------------

if {![info exists g_reports_dir]} {
    set g_reports_dir "reports"
}
file mkdir $g_reports_dir

if {![info exists g_project_dir]} {
    set g_project_dir "project"
}

set cdc_csv [file normalize [file join $g_reports_dir "ds_libero_cdc.csv"]]

# Write SmartTime batch script to generate the inter-clock domain CDC timing report
set st_script [file join $g_project_dir "designer" "run_st_cdc.tcl"]
file mkdir [file dirname $st_script]
set fp [open $st_script w]
puts $fp "# Generated by DS-T1.22 ds_cdc_evidence_impl.tcl"
puts $fp "# Microchip Libero SoC SmartTime inter-clock domain timing report"
puts $fp "report -type timing -analysis max -include_clock_domains yes -format csv [list $cdc_csv]"
close $fp

if {![catch {exec git rev-parse HEAD} git_sha]} {
    puts "INFO: DS-T1.22: Git SHA: $git_sha"
}

puts "DS-T1.22: Running SmartTime post-route CDC analysis via $st_script..."
if {[catch {run_tool -name {VERIFYTIMING} -script $st_script} err]} {
    error "DS-T1.22: Failed to execute SmartTime CDC report: $err"
}

# Verify report was generated and is non-empty
if {![file exists $cdc_csv] || [file size $cdc_csv] == 0} {
    error "DS-T1.22: SmartTime post-route CDC report ($cdc_csv) was not generated or is empty"
}

set fp [open $cdc_csv r]
set cdc_data [read $fp]
close $fp
puts "=== DS-T1.22 SmartTime Report Excerpt ($cdc_csv) ==="
puts $cdc_data
puts "=== End DS-T1.22 SmartTime Report Excerpt ==="

puts "DS_EVIDENCE ds_libero_cdc.csv $cdc_csv"
puts "INFO: DS-T1.22: Libero post-route SmartTime CDC report generated successfully: $cdc_csv"
