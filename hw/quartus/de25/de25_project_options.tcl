set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[4]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[5]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[6]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[7]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[8]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[9]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[10]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[11]}
