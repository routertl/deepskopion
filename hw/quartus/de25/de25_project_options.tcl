# DS-P1.52: the HPS/io96b subsystem is no longer generated by a hand-authored
# qsys-script sourced from here. It is declared in the project-root ip.yml
# (`platform.hps` + `ips: [{type: intel_agilex_5_soc, config: {hps_regenerate:
# true, hps_emif: true, ...}}]`, DS-P2.196) and rendered by rr's own pre-synth HPS
# generator (`rr synth run` -> sdk/engine/hps_gen.generate_hps_pre_synth`),
# NOT by tcl_hooks. The measured defect this replaces: the hand-tcl
# add_component-by-file hook (DS-P2.91, commit 3b16547) looked like the
# proven RTL-P3.722 Option A fix and passed its own static text guard, but a
# fresh queued bitstream still failed quartus_pfg Error 20809 ("HPS does not
# present in .sof file") — the black-box persisted at a layer the tcl-level
# guard could not see. rr's own add_component-by-file render is the mechanism
# actually proven on real silicon (rr-ddr-stream de25_hps_smoke, fb7a61f).

# Agilex 5 platform facts needed by the HPS/io96b subsystem.
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ

# DS-T1.20: register the Design Assistant waivers for the TMC-20025 rows that
# come from generated EMIF/IOPLL SDCs and the board master.sdc. Each waiver
# matches one exact SDC file:line and states why ignoring it changes no timing
# path on this topology. Without this assignment all 22 rows stay unwaived and
# ds_drc_evidence_impl.tcl fails the build. Quartus only reads the file, so
# the assignment points at the committed copy.
set _ds_waiver_file [file normalize [file join [file dirname [info script]] de25_generated_sdc_waivers.dawf]]
if {![file isfile $_ds_waiver_file]} {
    error "DS-T1.20: Design Assistant waiver file not found: $_ds_waiver_file"
}
set_global_assignment -name DESIGN_ASSISTANT_WAIVER_FILE $_ds_waiver_file

# DS-P2.309 interim (RTL-P2.2402): remove when rr ships the per-target pull key (DS-P3.269).
# Every GPIO_D header input idles HIGH (UART RX, SPI CS and I2C all idle high):
# an undriven input with no pull reads low and the I2C logger reports a stretch storm.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[0]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[1]}
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_D[2]}
