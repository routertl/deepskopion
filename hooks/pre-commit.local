# rr unknown-llm (AI-generated)
# ── Which Python tests a commit runs (DS-P2.220) ──
#
# This hook runs FIXED legs: the guard modules named below, each for its own
# subject. It does not select tests from the staged files, so a change can
# break a suite none of these legs runs.
#
# Selection by the change happens at land, in the bench's git-land retest
# (the orchestration repository's tools/land_rebase_retest.py; deepskopion is
# opted in under `incoming_closure` in its admin/land_retest.yml, TIC-P2.742). With no
# upstream change it retests every test that imports a changed .py module,
# directly or through an import chain; cocotb benches stay out.
#
# Not covered until TIC-P2.742's extension lands: a change to a data file only
# (a YAML declaration, VHDL, requirements.yml) seeds no import closure, so the
# tests that read that file are not selected. Measured 2026-11-07 by replaying
# select(): e7715359 (tools/preflight/supported_environment.yml) selected no
# tools/golden_path/tests file, and 8ebcce01 (hw/rtl, stimulus requirements)
# did not select tools/tests/test_contract_mapping_drift_ds_p2_187.py; both
# reached main red. Until then, run the affected suites by hand before READY
# (tools/ds_python_suite.py's own selection, as the nightly does).

# Resolve ROUTERTL_ROOT from pip-installed SDK (no vendor submodule)
export ROUTERTL_ROOT
ROUTERTL_ROOT="$(rr sdk-path 2>/dev/null)"
export GHDL_EXTRA_FLAGS="${GHDL_EXTRA_FLAGS:--frelaxed}"

if command -v .venv/bin/python3 >/dev/null 2>&1; then
    while IFS= read -r req; do
        if ! output=$(.venv/bin/python3 -c "from sdk.cli.requirements import load_requirements; load_requirements('$req')" 2>&1); then
            echo "ERROR: requirements.yml schema validation failed: $req" >&2
            echo "$output" >&2
            exit 1
        fi
    done < <(find hw/ -name 'requirements.yml' -not -path '*/libs/*' -not -path '*/.git/*')
    echo "✓ requirements.yml schema validation passed"
fi

# ── DS-X1 (DS-P1.27) — bench-local path pollution guard ──
#
# The golden path is clone-and-build, and it dies the moment a tracked lock,
# hook or generated source names a path that exists only on this bench. The
# sweep lives in tools/tests/test_no_local_path_pollution.py; THIS leg is what
# arms it. project.yml's target has `hooks.pre_commit.tests: []` and there is
# no CI, so without this the guard was a file nobody ran while two docs claimed
# it gated commits — the exact false-green the golden path documents.
#
# It reads the INDEX, so it judges what the commit will actually contain (see
# that module's docstring for why the worktree is the wrong thing to scan).
# Cheap: five `git grep --cached` sweeps, ~0.2 s.
#
# Fails CLOSED. A guard that could not run is not a green guard, so a missing
# pytest / collection error refuses the commit too — it just says so honestly
# rather than blaming the staged files (the run_gate doctrine in
# .routertl/hooks/project-pre-commit).
#
# Everything below prints to STDOUT, deliberately. The routertl multiplexer
# .routertl/hooks/pre-commit runs `exec 9>"$lock" 2>/dev/null` (RTL-P3.959) —
# an `exec` with no command, so that redirect is PERMANENT for the rest of the
# hook and is inherited by the project-pre-commit it exec's. Measured here
# 2026-08-12: with this guard failing, `pre-commit 2>err 1>out` leaves err at
# 0 bytes. A refusal explained only on stderr is a silent exit-1. (Worth
# fixing routertl-side; not this repo's file.)
if [ -x ".venv/bin/python3" ]; then
    DS_GUARD_PY=".venv/bin/python3"
else
    DS_GUARD_PY="python3"
fi
echo "🚧 Sweeping the index for bench-local paths (DS-X1)..."
ds_guard_rc=0
ds_guard_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider \
    tools/tests/test_no_local_path_pollution.py 2>&1) || ds_guard_rc=$?
if [ "$ds_guard_rc" -ne 0 ]; then
    printf '%s\n' "$ds_guard_out"
    echo ""
    case "$ds_guard_rc" in
        1)
            echo "❌ Bench-local path pollution (DS-X1 / DS-P1.27). Commit aborted."
            echo "   A staged file names a path that exists only on this bench,"
            echo "   so a lone clone could not resolve it. Neutralize the path"
            echo "   (project-root-relative, or an in-repo vendored copy) and"
            echo "   re-stage. Exemptions are exact paths in _EXEMPT_FILES."
            ;;
        *)
            echo "❌ GATE COULD NOT RUN: bench-local path guard (exit $ds_guard_rc)."
            echo "   It never inspected your code, so this is NOT a finding about"
            echo "   the staged files. Interpreter: $DS_GUARD_PY"
            echo "   Usual cause: pytest missing from that interpreter, or a"
            echo "   collection error in the guard module."
            echo "   Commit aborted — a gate that cannot run is not a green gate."
            ;;
    esac
    exit 1
fi
echo "✓ No bench-local paths in the index (DS-X1)"

# ── DS-T1.17 — golden-path preflight suite ──
#
# tools/preflight/tests proves the pre_build preflight agrees with the
# committed targets and datalogger config. Nothing ran it: DS-P2.121 removed
# CAN datalogger id 20 from datalogger_config.yml with this suite red, and
# every Zybo build then stopped in preflight before Vivado (DS-T1.17), so the
# launch timing audit had no Zybo constraint or report_cdc evidence at all.
# ~15 s. Fails CLOSED, like the legs above.
echo "🚧 Judging the committed targets against the golden-path preflight (DS-T1.17)..."
ds_preflight_rc=0
ds_preflight_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider \
    tools/preflight/tests 2>&1) || ds_preflight_rc=$?
if [ "$ds_preflight_rc" -ne 0 ]; then
    printf '%s\n' "$ds_preflight_out"
    echo ""
    case "$ds_preflight_rc" in
        1)
            echo "❌ Golden-path preflight disagrees with the tree (DS-T1.17). Commit aborted."
            echo "   A target, datalogger_config.yml or supported_environment.yml"
            echo "   change would stop the build in pre_build. Bring the"
            echo "   declaration and the design back into agreement."
            ;;
        *)
            echo "❌ GATE COULD NOT RUN: golden-path preflight suite (exit $ds_preflight_rc)."
            echo "   It never inspected your code. Interpreter: $DS_GUARD_PY"
            echo "   Commit aborted — a gate that cannot run is not a green gate."
            ;;
    esac
    exit 1
fi
echo "✓ Golden-path preflight agrees with the committed tree (DS-T1.17)"

# ── DS-P2.12 — doc link checker guard ──
#
# Scans markdown documentation for broken relative links via the pytest guard
# tools/tests/test_doc_lint_regression_ds_p2_13.py (which runs
# tools/doc-lint/check_links.py). Catches broken doc links at commit time.
#
# Fails CLOSED like every other leg here.
# Everything prints to STDOUT (see the DS-X1 comment on routertl's permanent
# exec 9> redirect).
echo "🚧 Checking documentation links (DS-P2.12)..."
ds_doclint_rc=0
ds_doclint_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider \
    tools/tests/test_doc_lint_regression_ds_p2_13.py 2>&1) || ds_doclint_rc=$?
if [ "$ds_doclint_rc" -ne 0 ]; then
    printf '%s\n' "$ds_doclint_out"
    echo ""
    case "$ds_doclint_rc" in
        1)
            echo "❌ doc-lint: broken documentation link found (DS-P2.12). Commit aborted."
            echo "   One or more relative links in docs/, datalogger markdown files, or"
            echo "   README.md point to non-existent targets. Run 'make doc-lint' or"
            echo "   '$DS_GUARD_PY tools/doc-lint/check_links.py' to inspect and fix"
            echo "   broken links."
            ;;
        *)
            echo "❌ GATE COULD NOT RUN: doc-lint checker guard (exit $ds_doclint_rc)."
            echo "   It never inspected your docs, so this is NOT a finding about"
            echo "   the staged files. Interpreter: $DS_GUARD_PY"
            echo "   Usual cause: pytest missing from that interpreter, or a"
            echo "   collection error in the guard module."
            echo "   Commit aborted — a gate that cannot run is not a green gate."
            ;;
    esac
    exit 1
fi
echo "✓ Documentation links OK (DS-P2.12)"

# ── DS-P2.197 — the public CI workflow stays honest ──
#
# test_public_ci_ds_p2_197.py and test_ci_routertl_floor_leg_ds_p2_209.py read
# .github/workflows/ci.yml and tools/ci/. They ran only in public CI, so a
# change to the workflow's install line turned one red on main unseen
# (DS-P2.209, 8399e64f). test_de25_canfd_target_ds_p2_135.py and
# test_pfsoc_mss_fabric_selftest_ds_p2_126.py are cross-target / core-mux text
# guards that also broke on main when target/core commits did not run the full
# public desk suite (2a8e1eb6, 8ebcce01). All four take well under a second.
# Fails CLOSED like every other leg here.
echo "🚧 Checking the public CI workflow (DS-P2.197)..."
ds_ci_rc=0
ds_ci_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider \
    tools/tests/test_public_ci_ds_p2_197.py \
    tools/tests/test_ci_routertl_floor_leg_ds_p2_209.py \
    tools/tests/test_de25_canfd_target_ds_p2_135.py \
    tools/tests/test_pfsoc_mss_fabric_selftest_ds_p2_126.py \
    tools/tests/test_pfsoc_gpt_build_job_ds_p2_149.py \
    tools/tests/test_pfsoc_fit_e2e_leg_ds_t3_39.py \
    tools/tests/test_de25_gate_ds_p3_177.py \
    2>&1) || ds_ci_rc=$?
if [ "$ds_ci_rc" -ne 0 ]; then
    printf '%s\n' "$ds_ci_out"
    echo ""
    case "$ds_ci_rc" in
        1)
            echo "❌ the public CI workflow breaks a rule its guards hold (DS-P2.197)."
            echo "   Commit aborted."
            ;;
        *)
            echo "❌ GATE COULD NOT RUN: public CI workflow guard (exit $ds_ci_rc)."
            echo "   Interpreter: $DS_GUARD_PY"
            echo "   Commit aborted — a gate that cannot run is not a green gate."
            ;;
    esac
    exit 1
fi
echo "✓ Public CI workflow guards pass (DS-P2.197)"

# ── DS-P2.407 — the .gitignore rules guard judges the STAGED rules ──
#
# test_export_dotfiles_ds_p2_339 pins the .gitignore rule count and hash. No
# leg ran it, so ebd7d70d added a rule without its pin and main went red unseen.
# The staged .gitignore, the staged guard (its pins) and its helper modules are
# copied out of the index and the guard runs on that copy, so neither the
# working tree nor unstaged pins can pass a staged change. About 5 s.
echo "🚧 Checking the staged .gitignore rules against their pins (DS-P2.407)..."
ds_gi_rc=0
ds_gi_dir=$(mktemp -d) || ds_gi_dir=""
if [ -z "$ds_gi_dir" ] || [ ! -d "$ds_gi_dir" ]; then
    echo "❌ GATE COULD NOT RUN: .gitignore rules guard (no scratch directory)."
    echo "   Commit aborted — a gate that cannot run is not a green gate."
    exit 1
fi
# The raw staged blobs (git cat-file applies no smudge or text conversion), written by this shell.
ds_gi_snapshot() {
    for ds_gi_f in .gitignore tools/tests/test_export_dotfiles_ds_p2_339.py tools/export_github.py \
            tools/public_artifact_hygiene.py; do
        mkdir -p "$ds_gi_dir/$(dirname "$ds_gi_f")" && git cat-file blob ":$ds_gi_f" > "$ds_gi_dir/$ds_gi_f" \
            2>/dev/null || return 1
    done
}
# git does not read a symlinked .gitignore, so the guard must not judge a symlink's target as the rules.
ds_gi_mode=$(git ls-files -s -- .gitignore | cut -d' ' -f1)
if [ "$ds_gi_mode" != "100644" ] && [ "$ds_gi_mode" != "100755" ]; then
    ds_gi_out="the staged .gitignore is not a regular file (index mode ${ds_gi_mode:-absent})"; ds_gi_rc=1
elif ds_gi_snapshot; then
    # Run from here (DS_GUARD_PY may be the relative .venv/bin/python3); the guard finds the copied .gitignore
    # from its own path. Inherited pytest options are cleared, and only "1 passed" counts as a pass.
    ds_gi_out=$(env -u PYTEST_ADDOPTS "$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider -o addopts= \
        "$ds_gi_dir/tools/tests/test_export_dotfiles_ds_p2_339.py::test_the_gitignore_rules_are_unchanged" 2>&1) \
        || ds_gi_rc=$?
    if [ "$ds_gi_rc" -eq 0 ] && ! printf '%s\n' "$ds_gi_out" | grep -q "1 passed"; then
        ds_gi_out="$ds_gi_out
the guard did not report 1 passed"; ds_gi_rc=2
    fi
else
    ds_gi_out="the .gitignore guard or its helpers are not in the index"; ds_gi_rc=2
fi
rm -rf "$ds_gi_dir"
if [ "$ds_gi_rc" -ne 0 ]; then
    printf '%s\n' "$ds_gi_out"
    echo ""
    case "$ds_gi_rc" in
        1)
            echo "❌ the staged .gitignore rules do not match their pins (DS-P2.407)."
            echo "   Update GITIGNORE_RULES and GITIGNORE_RULES_SHA256 in"
            echo "   tools/tests/test_export_dotfiles_ds_p2_339.py with the rule change."
            echo "   Commit aborted."
            ;;
        *)
            echo "❌ GATE COULD NOT RUN: .gitignore rules guard (exit $ds_gi_rc)."
            echo "   Interpreter: $DS_GUARD_PY"
            echo "   Commit aborted — a gate that cannot run is not a green gate."
            ;;
    esac
    exit 1
fi
echo "✓ Staged .gitignore rules match their pins (DS-P2.407)"

# ── DS-P3.337 — the telemetry exporter's copy blocks, executed ──
#
# The documented ssh and card copy blocks run inside bubblewrap with stub tools.
# A docs-only edit seeds no import closure at land, so no other check runs this
# guard when the doc changes. Public CI cannot run it (the Forgejo job's Docker
# container refuses user namespaces; the GitHub job installs no bubblewrap), so it
# runs here, in the private tree (context.json, as the legs below), on every
# commit. A host without bwrap or markdown-it-py fails it.
if git cat-file -e :context.json 2>/dev/null; then
    echo "🚧 Running the telemetry exporter copy blocks in a sandbox (DS-P3.337)..."
    # Judge the STAGED doc: a broken staged copy with a corrected unstaged one must not pass.
    ds_copy_rc=0
    ds_copy_doc=$(mktemp)
    if git show :docs/software/telemetry_exporter.md > "$ds_copy_doc" 2>/dev/null; then
        # DS_COPY_BLOCKS_REQUIRED: a missing bwrap or markdown-it fails here, never skips (DS-P3.339).
        ds_copy_out=$(DS_COPY_BLOCKS_REQUIRED=1 DS_TELEMETRY_DOC="$ds_copy_doc" "$DS_GUARD_PY" -m pytest -q --no-header \
            -p no:cacheprovider tools/tests/test_telemetry_copy_blocks_execute_ds_p3_337.py 2>&1) \
            || ds_copy_rc=$?
    else
        ds_copy_out="docs/software/telemetry_exporter.md is not in the index"; ds_copy_rc=1
    fi
    rm -f "$ds_copy_doc"
    if [ "$ds_copy_rc" -ne 0 ]; then
        printf '%s\n' "$ds_copy_out"
        echo ""
        case "$ds_copy_rc" in
            1)
                echo "❌ a documented telemetry copy block does not do what the doc says (DS-P3.337)."
                echo "   Commit aborted. See docs/software/telemetry_exporter.md, Per board."
                ;;
            *)
                echo "❌ GATE COULD NOT RUN: telemetry copy-block guard (exit $ds_copy_rc)."
                echo "   It never ran the blocks, so this is NOT a finding about the staged"
                echo "   files. Interpreter: $DS_GUARD_PY (bwrap is required)."
                echo "   Commit aborted — a gate that cannot run is not a green gate."
                ;;
        esac
        exit 1
    fi
    echo "✓ Telemetry exporter copy blocks do what the doc says (DS-P3.337)"
fi

# ── DS-P3.184 — pinned write plane is the silicon-witnessed one ──
#
# A commit moved the rr_ddr_stream pin past the image the DE25 gate witnessed and
# passed this hook, because the guard that refuses it was not a leg here. The
# witness record stays in the private tree, so a public clone has nothing to
# compare and skips this leg; context.json is the same switch DS-P1.77 uses.
if git cat-file -e :context.json 2>/dev/null; then
    echo "🚧 Checking the rr_ddr_stream pin against the DE25 witness (DS-P3.184)..."
    ds_witness_rc=0
    ds_witness_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider \
        tools/tests/test_ds_p1_79_de25_silicon_witness.py::test_pinned_write_plane_is_the_silicon_witnessed_one 2>&1) \
        || ds_witness_rc=$?
    if [ "$ds_witness_rc" -ne 0 ]; then
        printf '%s\n' "$ds_witness_out"
        echo ""
        case "$ds_witness_rc" in
            1)
                echo "❌ the pinned rr_ddr_stream write plane is not the one witnessed on DE25"
                echo "   silicon (DS-P3.184). Commit aborted. Re-run the DE25 cold-boot gate"
                echo "   and record the new image in its manifest."
                ;;
            *)
                echo "❌ GATE COULD NOT RUN: DE25 witness guard (exit $ds_witness_rc)."
                echo "   It never compared the pin, so this is NOT a finding about the"
                echo "   staged files. Interpreter: $DS_GUARD_PY"
                echo "   Commit aborted — a gate that cannot run is not a green gate."
                ;;
        esac
        exit 1
    fi
    echo "✓ rr_ddr_stream pin matches the DE25 witness (DS-P3.184)"
fi

# ── DS-P2.206 — RouteWave renders the PolarFire known-answer captures ──
#
# Two tests open the PolarFire silicon captures (VCD and CSV) in RouteWave and
# assert the rendered values. No check ran them, and both sat red on a
# test-side race for days. They and their evidence stay in the private tree, so
# a public clone skips this leg (context.json, as above). A skipped test (no
# RouteWave binary found) refuses the commit: a render check that did not run
# is not a pass.
if git cat-file -e :context.json 2>/dev/null; then
    echo "🚧 Checking RouteWave renders the PolarFire known-answer captures (DS-P2.206)..."
    ds_rw_rc=0
    ds_rw_out=$("$DS_GUARD_PY" -m pytest -q --no-header -p no:cacheprovider -rs \
        tools/tests/test_pfsoc_mmio_routewave_p2_128.py::test_routewave_renders_known_answer_pattern \
        tools/tests/test_pfsoc_rea_mmio_rr_capture_ds_p2_128.py::test_routewave_renders_the_rr_capture \
        2>&1) || ds_rw_rc=$?
    if [ "$ds_rw_rc" -eq 0 ] && printf '%s\n' "$ds_rw_out" | grep -q " skipped"; then
        ds_rw_rc=5
    fi
    if [ "$ds_rw_rc" -ne 0 ]; then
        printf '%s\n' "$ds_rw_out"
        echo ""
        case "$ds_rw_rc" in
            1)
                echo "❌ RouteWave did not render the PolarFire known-answer captures as the"
                echo "   witness records them (DS-P2.206). Commit aborted."
                ;;
            *)
                echo "❌ GATE COULD NOT RUN: RouteWave render check (exit $ds_rw_rc; 5 = skipped,"
                echo "   no RouteWave binary). Set ROUTEWAVE_BIN or put routewave on PATH."
                echo "   Interpreter: $DS_GUARD_PY"
                echo "   Commit aborted — a gate that cannot run is not a green gate."
                ;;
        esac
        exit 1
    fi
    echo "✓ RouteWave renders the PolarFire known-answer captures (DS-P2.206)"
fi

